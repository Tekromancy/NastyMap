{
  "name": "nastymap",
  "version": "1.0.0",
  "description": "High-performance interactive React visualization and parsing library for Nmap XML scan outputs, network topology graphs, GeoIP world mapping, and security diffing.",
  "author": "NastyMap Team",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./parser": {
      "types": "./src/parser/index.ts",
      "import": "./src/parser/index.ts",
      "default": "./src/parser/index.ts"
    },
    "./topology": {
      "types": "./src/topology/index.ts",
      "import": "./src/topology/index.ts",
      "default": "./src/topology/index.ts"
    },
    "./geoip": {
      "types": "./src/geoip/index.ts",
      "import": "./src/geoip/index.ts",
      "default": "./src/geoip/index.ts"
    },
    "./diff": {
      "types": "./src/diff/index.ts",
      "import": "./src/diff/index.ts",
      "default": "./src/diff/index.ts"
    },
    "./export": {
      "types": "./src/export/index.ts",
      "import": "./src/export/index.ts",
      "default": "./src/export/index.ts"
    },
    "./samples": {
      "types": "./src/data/sample-scans.ts",
      "import": "./src/data/sample-scans.ts",
      "default": "./src/data/sample-scans.ts"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.0",
    "lucide-react": "^1.31.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
